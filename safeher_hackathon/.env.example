# App / OAuth
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
JWT_SECRET=

# Database (MySQL)
DATABASE_URL=mysql://user:password@localhost:3306/safeher

# Maps / Forge proxy
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Mappls (MapmyIndia) - Safe Route Finder
# Required for Directions/Autosuggest/Nearby proxy calls
MAPPLS_REST_API_KEY=
# Optional dedicated JS SDK key. Falls back to MAPPLS_REST_API_KEY if empty.
MAPPLS_MAP_SDK_KEY=
# Optional OAuth credentials for Atlas APIs when your account requires OAuth auth headers
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=

# Optional runtime
PORT=3000
