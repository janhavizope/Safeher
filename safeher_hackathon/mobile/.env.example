# Mappls Mobile SDK Key (from Mappls Console - Mobile app)
MAPPLS_MOBILE_SDK_KEY=your_mobile_sdk_key

# Mappls Client ID and Secret (from Mappls Console - if your account uses OAuth)
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=

# Backend API (points to your web server)
API_BASE_URL=http://localhost:3000

# Feature flags
ENABLE_DARK_MODE=true
ENABLE_SOS_EMERGENCY=true
ENABLE_NEARBY_LANDMARKS=true
ENABLE_REROUTE=true
